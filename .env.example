# Copie para .env.local e preencha.
#
# Com o Supabase local (npx supabase start), os três valores aparecem em
# `npx supabase status`: API URL, anon key e service_role key.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-anon-key
# Secreta: ignora o RLS. Nunca commitar nem expor no frontend.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key
